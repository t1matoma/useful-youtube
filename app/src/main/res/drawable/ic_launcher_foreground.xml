<?xml version="1.0" encoding="utf-8"?>
<!-- Concentric rings around a play mark.
     Drawn on the 512 canvas of the source SVG; the group maps its 512 units onto the visible 72dp of the
     108dp adaptive icon (scale 72/512, offset 18dp), so the outer ring stays inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.140625"
        android:scaleY="0.140625"
        android:translateX="18"
        android:translateY="18">
        <path
            android:pathData="M256,92a164,164 0,1 1,0 328a164,164 0,1 1,0 -328Z"
            android:strokeWidth="28"
            android:strokeColor="@color/launcher_accent" />
        <path
            android:pathData="M256,150a106,106 0,1 1,0 212a106,106 0,1 1,0 -212Z"
            android:strokeAlpha="0.5"
            android:strokeWidth="28"
            android:strokeColor="@color/launcher_accent" />
        <path
            android:fillColor="@color/launcher_accent"
            android:pathData="M256,198a58,58 0,1 1,0 116a58,58 0,1 1,0 -116Z" />
        <path
            android:fillColor="@color/launcher_play"
            android:pathData="M242,228L242,284L286,256Z"
            android:strokeWidth="10"
            android:strokeColor="@color/launcher_play"
            android:strokeLineJoin="round" />
    </group>
</vector>
